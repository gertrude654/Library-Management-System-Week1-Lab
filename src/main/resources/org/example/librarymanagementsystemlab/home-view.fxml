<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Label?>
<GridPane xmlns="http://javafx.com/javafx"
          xmlns:fx="http://javafx.com/fxml"
          fx:controller="org.example.librarymanagementsystemlab.controller.HomeController"
          hgap="20" vgap="20" style="-fx-background-color: #2c3e50;">

    <!-- Set padding using Insets -->
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <!-- Main layout container -->
    <VBox alignment="CENTER" spacing="30">

        <!-- Title -->
        <Label text="Library Management System" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #ecf0f1;" />

        <!-- Horizontal layout for buttons -->
        <HBox spacing="20" alignment="CENTER">

            <!-- Button for Patrons -->
            <Button text="Patrons" onAction="#openPatronsPage"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 16px;
                           -fx-background-radius: 8; -fx-cursor: hand;" />

            <!-- Button for Books -->
            <Button text="Books" onAction="#openBooksPage"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 16px;
                           -fx-background-radius: 8; -fx-cursor: hand;" />

            <!-- Button for Transactions -->
            <Button text="Transactions" onAction="#openTransactionsPage"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 16px;
                           -fx-background-radius: 8; -fx-cursor: hand;" />

        </HBox>

    </VBox>

</GridPane>
